{
  "name": "sifter-skillup",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test": "jest",
    "gen:simulators": "ts-node scripts/generateSimulators.ts",
    "gen:simulators:all": "ts-node scripts/generateSimulators.ts --all",
    "gen:lab": "ts-node scripts/generateSimulators.ts --lab --file",
    "gen:interview": "ts-node scripts/generateSimulators.ts --interview --file",
    "gen:full": "ts-node scripts/generateSimulators.ts --all && ts-node scripts/generateSimulators.ts --lab --all"
  },
  "dependencies": {
    "@coinbase/wallet-mobile-sdk": "^0.1.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.3.1",
    "@shopify/flash-list": "1.6.4",
    "@supabase/supabase-js": "^2.43.4",
    "@tanstack/react-query": "^5.51.0",
    "expo": "~55.0.9",
    "expo-crypto": "~13.0.2",
    "expo-font": "~12.0.10",
    "expo-haptics": "~13.0.1",
    "expo-image-picker": "~15.1.0",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~55.0.0",
    "expo-notifications": "^55.0.13",
    "expo-router": "^55.0.8",
    "expo-secure-store": "~13.0.2",
    "expo-splash-screen": "^55.0.13",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.84.1",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-logs": "~5.0.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.13",
    "react-native-webview": "13.8.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^12.4.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~18.2.79",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.11",
    "ts-node": "^10.9.2",
    "typescript": "~5.3.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@supabase/.*|@tanstack/.*|zustand)"
    ]
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1"
  }
}
