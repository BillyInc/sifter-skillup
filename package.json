{
  "name": "sifter-levelup",
  "version": "1.0.0",
  "packageManager": "pnpm@10.33.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "vite --config web/vite.config.mjs --host 127.0.0.1 --port 5173",
    "build": "vite --config web/vite.config.mjs build",
    "start": "node ./node_modules/expo/bin/cli start",
    "android": "node ./node_modules/expo/bin/cli run:android",
    "ios": "node ./node_modules/expo/bin/cli run:ios",
    "build:android": "node scripts/checkLegalConfig.mjs && eas build --platform android",
    "build:ios": "node scripts/checkLegalConfig.mjs && eas build --platform ios",
    "web": "vite --config web/vite.config.mjs --host 127.0.0.1 --port 5173",
    "web:expo": "node ./node_modules/expo/bin/cli start --web",
    "build:web": "vite --config web/vite.config.mjs build",
    "build:web:expo": "node scripts/checkLegalConfig.mjs && node ./node_modules/expo/bin/cli export --platform web",
    "check:legal-config": "node scripts/checkLegalConfig.mjs",
    "test": "jest",
    "test:sociology-route": "node scripts/sociologyRouteSmoke.cjs",
    "test:sociology-report": "node scripts/sociologyReportSmoke.cjs",
    "test:sociology-learning-plan": "node scripts/sociologyLearningPlanPersistenceSmoke.cjs",
    "test:programme-scale": "node scripts/programmeGuidanceScaleSmoke.cjs",
    "gen:simulators": "ts-node scripts/generateSimulators.ts",
    "gen:simulators:all": "ts-node scripts/generateSimulators.ts --all",
    "gen:lab": "ts-node scripts/generateSimulators.ts --lab --file",
    "gen:interview": "ts-node scripts/generateSimulators.ts --interview --file",
    "gen:full": "ts-node scripts/generateSimulators.ts --all && ts-node scripts/generateSimulators.ts --lab --all",
    "lint": "node ./node_modules/expo/bin/cli lint"
  },
  "dependencies": {
    "@coinbase/wallet-mobile-sdk": "^0.1.0",
    "@craftzdog/react-native-buffer": "^6.1.1",
    "@ethersproject/shims": "^5.8.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/spline-sans-mono": "^0.4.2",
    "@expo/metro-runtime": "^55.0.7",
    "@fatsolutions/tongo-sdk": "^1.5.0",
    "@nozbe/watermelondb": "^0.28.0",
    "@nozbe/with-observables": "^1.6.0",
    "@privy-io/expo": "^0.64.0",
    "@privy-io/expo-native-extensions": "^0.0.9",
    "@privy-io/react-auth": "^3.22.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@shopify/flash-list": "2.0.2",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.43.4",
    "@tanstack/react-query": "^5.51.0",
    "ethers": "^6.16.0",
    "expo": "~55.0.28",
    "expo-apple-authentication": "~55.0.13",
    "expo-application": "~55.0.14",
    "expo-clipboard": "~8.0.0",
    "expo-constants": "~55.0.11",
    "expo-crypto": "~55.0.12",
    "expo-dev-client": "^55.0.26",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.12",
    "expo-image-picker": "~55.0.16",
    "expo-linear-gradient": "~55.0.11",
    "expo-linking": "~55.0.0",
    "expo-local-authentication": "~55.0.11",
    "expo-notifications": "^55.0.13",
    "expo-router": "^55.0.8",
    "expo-screen-orientation": "~55.0.11",
    "expo-secure-store": "~55.0.11",
    "expo-splash-screen": "^55.0.13",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "^55.0.15",
    "expo-updates": "~55.0.18",
    "expo-web-browser": "~55.0.14",
    "fast-text-encoding": "^1.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "~0.76.7",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-logs": "~5.0.0",
    "react-native-passkeys": "^0.4.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.13.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "^0.7.0",
    "starkzap": "^3.0.0",
    "starkzap-native": "^3.0.0",
    "viem": "^2.48.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/plugin-proposal-decorators": "^7.24.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.0.0",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.13",
    "@vitejs/plugin-react": "^5.0.4",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3",
    "vite": "^7.1.5"
  },
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 30000,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/.claude/worktrees/",
      "<rootDir>/node_modules/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/worktrees/"
    ],
    "watchPathIgnorePatterns": [
      "<rootDir>/.claude/worktrees/"
    ],
    "moduleNameMapper": {
      "^react-native/Libraries/BatchedBridge/NativeModules$": "<rootDir>/__mocks__/nativeModules.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@supabase/.*|@tanstack/.*|zustand)"
    ]
  },
  "pnpm": {
    "overrides": {
      "shell-quote": ">=1.9.0",
      "axios": ">=1.16.0",
      "form-data": ">=4.0.6",
      "hono": ">=4.12.25",
      "js-cookie": ">=3.0.7",
      "socket.io-parser": ">=4.2.7",
      "brace-expansion@^5": ">=5.0.9",
      "js-yaml@^4": ">=4.3.1",
      "ws@^8": ">=8.21.0",
      "@xmldom/xmldom": ">=0.8.13",
      "uuid": ">=11.1.1",
      "react-native-mmkv": ">=2.11.0",
      "qs": ">=6.15.2",
      "bn.js": ">=5.2.3",
      "@babel/runtime": ">=7.26.10",
      "@tootallnate/once": ">=2.0.1",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4"
    }
  }
}
