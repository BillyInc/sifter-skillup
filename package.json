{
  "name": "sifter-skillup",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test": "jest",
    "gen:simulators": "ts-node scripts/generateSimulators.ts",
    "gen:simulators:all": "ts-node scripts/generateSimulators.ts --all",
    "gen:lab": "ts-node scripts/generateSimulators.ts --lab --file",
    "gen:interview": "ts-node scripts/generateSimulators.ts --interview --file",
    "gen:full": "ts-node scripts/generateSimulators.ts --all && ts-node scripts/generateSimulators.ts --lab --all",
    "lint": "expo lint"
  },
  "dependencies": {
    "@coinbase/wallet-mobile-sdk": "^0.1.0",
    "@craftzdog/react-native-buffer": "^6.1.1",
    "@ethersproject/shims": "^5.8.0",
    "@expo/metro-runtime": "^55.0.7",
    "@fatsolutions/tongo-sdk": "^1.5.0",
    "@nozbe/watermelondb": "^0.28.0",
    "@nozbe/with-observables": "^1.6.0",
    "@privy-io/expo": "^0.64.0",
    "@privy-io/expo-native-extensions": "^0.0.9",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.43.4",
    "@tanstack/react-query": "^5.51.0",
    "ethers": "^6.16.0",
    "expo": "~55.0.9",
    "expo-apple-authentication": "~55.0.13",
    "expo-application": "~55.0.14",
    "expo-clipboard": "~8.0.0",
    "expo-constants": "~55.0.11",
    "expo-crypto": "~55.0.12",
    "expo-dev-client": "^55.0.26",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.12",
    "expo-image-picker": "~55.0.16",
    "expo-linear-gradient": "~55.0.11",
    "expo-linking": "~55.0.0",
    "expo-local-authentication": "~55.0.11",
    "expo-notifications": "^55.0.13",
    "expo-router": "^55.0.8",
    "expo-screen-orientation": "~55.0.11",
    "expo-secure-store": "~55.0.11",
    "expo-splash-screen": "^55.0.13",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "^55.0.15",
    "expo-updates": "~55.0.18",
    "expo-web-browser": "~55.0.14",
    "fast-text-encoding": "^1.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "~0.76.7",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-logs": "~5.0.0",
    "react-native-passkeys": "^0.4.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.13.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "^0.7.0",
    "starkzap-native": "^3.0.0",
    "viem": "^2.48.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-decorators": "^7.24.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.0",
    "@types/react": "~19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.13",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^react-native/Libraries/BatchedBridge/NativeModules$": "<rootDir>/__mocks__/nativeModules.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@supabase/.*|@tanstack/.*|zustand)"
    ]
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1"
  }
}
