{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "module": "esnext",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "App.tsx",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "jest.setup.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    ".expo-web-test",
    "android",
    "ios",
    "backend",
    "babel.config.js",
    "metro.config.js",
    "eslint.config.js",
    "jest.config.js",
    "src/components/simulators/SimulatorCard_ADDITIONS.tsx",
    "src/components/simulators/SimulatorCard_PATCH.ts",
    "src/components/simulators/island06SolanaSimulatorDefs.tsx",
    "src/components/simulators/island12_13_15Sims.tsx",
    "src/components/simulators/walletEnhancedSims.tsx",
    "src/lib/database.ts",
    "src/lib/watermelonModels.ts",
    "src/lib/watermelonSchema.ts",
    "src/data/tracks/supplyChainTrack.ts",
    "src/data/tracks/supplyChainTrack_upgraded.ts",
    "src/data/tracks/onchainSleuthTrack.ts",
    "src/data/tracks/defi_research_analyst",
    "src/data/tracks/sc_analyst_junior",
    "src/data/tracks/spotTradingTrack.ts"
  ]
}
