# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── JWT (90-day tokens — users never re-login unless device violated) ──
JWT_SECRET=generate-a-strong-random-secret-min-32-chars

# ── App ───────────────────────────────────────────────────────
DEBUG=false
API_BASE_URL=https://api.sifter.app

# ── CORS ──────────────────────────────────────────────────────
WEB_DASHBOARD_URL=https://your-dashboard-domain.com

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather

# ── Base / Blockchain ─────────────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org

# ── Starknet RPC Pools ────────────────────────────────────────
# Comma-separated list — server round-robins for load balancing
# Get free keys from: alchemy.com, blastapi.io, nethermind.io
STARKNET_SEPOLIA_RPCS=https://starknet-sepolia.public.blastapi.io,https://free-rpc.nethermind.io/sepolia-juno,https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_7/YOUR_KEY
STARKNET_MAINNET_RPCS=https://starknet-mainnet.public.blastapi.io,https://free-rpc.nethermind.io/mainnet-juno

# ── Device / Session Enforcement ──────────────────────────────
SINGLE_DEVICE_ENFORCEMENT=true
DEVICE_SESSION_TTL_MINUTES=43200

# ── Push Notifications (FCM) ──────────────────────────────────
# Used to notify old device when new device logs in
FCM_SERVER_KEY=your-firebase-server-key

# ── AI (NEVER expose in client) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Market Intelligence Data Providers ───────────────────────
# Server-side backfill only. Never expose these through EXPO_PUBLIC_*.
MARKET_INTELLIGENCE_LLM_API_KEY=your-openai-compatible-market-intelligence-key
CAREERJET_AFFID=your-careerjet-affiliate-id
CAREERJET_API_KEY=your-careerjet-affiliate-id
JOOBLE_API_KEY=your-jooble-api-key
JOBBLE_API_KEY=your-jooble-api-key
RAPIDAPI_KEY=your-rapidapi-key
JSEARCH_RAPIDAPI_KEY=your-rapidapi-key
JSEARCH_RAPIDAPI_HOST=jsearch.p.rapidapi.com
OPENWEBNINJA_API_KEY=your-openwebninja-api-key

# ── Airtable CMS ─────────────────────────────────────────────
AIRTABLE_API_KEY=your-airtable-personal-access-token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLES=Tracks,Labs,LessonMetadata,FieldDescriptions
AIRTABLE_SYNC_INTERVAL_MINUTES=30

# ── Encryption (for OAuth token storage) ──────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# ── Portfolio Hub — Platform OAuth Credentials ────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://api.sifter.app/api/github/callback

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

INSTAGRAM_CLIENT_ID=your_meta_app_id
INSTAGRAM_CLIENT_SECRET=your_meta_app_secret
FACEBOOK_APP_ID=your_meta_app_id
FACEBOOK_APP_SECRET=your_meta_app_secret

MEDIUM_CLIENT_ID=your_medium_integration_client_id
MEDIUM_CLIENT_SECRET=your_medium_integration_client_secret

REDDIT_CLIENT_ID=your_reddit_app_client_id
REDDIT_CLIENT_SECRET=your_reddit_app_client_secret

BEHANCE_CLIENT_ID=your_adobe_client_id
BEHANCE_CLIENT_SECRET=your_adobe_client_secret

DRIBBBLE_CLIENT_ID=your_dribbble_client_id
DRIBBBLE_CLIENT_SECRET=your_dribbble_client_secret

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

VIMEO_CLIENT_ID=your_vimeo_client_id
VIMEO_CLIENT_SECRET=your_vimeo_client_secret
