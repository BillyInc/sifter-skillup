# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── JWT (90-day tokens — users never re-login unless device violated) ──
# Required, at least 32 random characters, unless DEBUG=true. With DEBUG=false the
# process REFUSES TO START if this is missing, the default, or shorter than 32.
# This applies to EVERY process that imports config: the API, the Celery worker
# and beat, scheduled jobs and scripts. Give each one the same secret (and
# check the secret in production is long enough BEFORE deploying this change).
# Leave this EMPTY here and set a real value in each environment; the shipped
# example is deliberately not a usable secret.
# generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=

# ── Account deletion privacy ──────────────────────────────────
# Keyed-hash secret for the deletion cooldown rows (the device id is stored only
# as an HMAC hash; no email is kept). Set a SEPARATE random value of 32+
# characters in production. If empty it falls back to JWT_SECRET, and when that
# is also a default or short value an ERROR is logged at startup (deletion still
# works). Changing it later makes existing hashed cooldowns stop matching, which
# only affects the 24 h sign-up cooldown.
ACCOUNT_DELETION_HASH_SECRET=
# Scheduled hard delete of self-deleted accounts (off unless true; dry run counts only).
# The retention window is never shorter than 7 days whatever is set here.
ACCOUNT_HARD_DELETE_ENABLED=false
ACCOUNT_HARD_DELETE_RETENTION_DAYS=30
ACCOUNT_HARD_DELETE_BATCH_SIZE=100

# ── App ───────────────────────────────────────────────────────
DEBUG=false
API_BASE_URL=https://api.sifter.app

# ── CORS ──────────────────────────────────────────────────────
WEB_DASHBOARD_URL=https://your-dashboard-domain.com

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather

# ── Base / Blockchain ─────────────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org

# ── Starknet RPC Pools ────────────────────────────────────────
# Comma-separated list — server round-robins for load balancing
# Get free keys from: alchemy.com, blastapi.io, nethermind.io
STARKNET_SEPOLIA_RPCS=https://starknet-sepolia.public.blastapi.io,https://free-rpc.nethermind.io/sepolia-juno,https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_7/YOUR_KEY
STARKNET_MAINNET_RPCS=https://starknet-mainnet.public.blastapi.io,https://free-rpc.nethermind.io/mainnet-juno

# ── Device / Session Enforcement ──────────────────────────────
SINGLE_DEVICE_ENFORCEMENT=true
DEVICE_SESSION_TTL_MINUTES=43200

# ── Push Notifications (FCM) ──────────────────────────────────
# Used to notify old device when new device logs in
FCM_SERVER_KEY=your-firebase-server-key

# ── AI (NEVER expose in client) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Market Intelligence Data Providers ───────────────────────
# Server-side backfill only. Never expose these through EXPO_PUBLIC_*.
MARKET_INTELLIGENCE_LLM_API_KEY=your-openai-compatible-market-intelligence-key
CAREERJET_AFFID=your-careerjet-affiliate-id
CAREERJET_API_KEY=your-careerjet-affiliate-id
JOOBLE_API_KEY=your-jooble-api-key
JOBBLE_API_KEY=your-jooble-api-key
RAPIDAPI_KEY=your-rapidapi-key
JSEARCH_RAPIDAPI_KEY=your-rapidapi-key
JSEARCH_RAPIDAPI_HOST=jsearch.p.rapidapi.com
OPENWEBNINJA_API_KEY=your-openwebninja-api-key

# ── Airtable CMS ─────────────────────────────────────────────
AIRTABLE_API_KEY=your-airtable-personal-access-token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLES=Tracks,Labs,LessonMetadata,FieldDescriptions
AIRTABLE_SYNC_INTERVAL_MINUTES=30

# ── Encryption (for OAuth token storage) ──────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# ── Portfolio Hub — Platform OAuth Credentials ────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=https://api.sifter.app/api/github/callback

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret

INSTAGRAM_CLIENT_ID=your_meta_app_id
INSTAGRAM_CLIENT_SECRET=your_meta_app_secret
FACEBOOK_APP_ID=your_meta_app_id
FACEBOOK_APP_SECRET=your_meta_app_secret

MEDIUM_CLIENT_ID=your_medium_integration_client_id
MEDIUM_CLIENT_SECRET=your_medium_integration_client_secret

REDDIT_CLIENT_ID=your_reddit_app_client_id
REDDIT_CLIENT_SECRET=your_reddit_app_client_secret

BEHANCE_CLIENT_ID=your_adobe_client_id
BEHANCE_CLIENT_SECRET=your_adobe_client_secret

DRIBBBLE_CLIENT_ID=your_dribbble_client_id
DRIBBBLE_CLIENT_SECRET=your_dribbble_client_secret

GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

VIMEO_CLIENT_ID=your_vimeo_client_id
VIMEO_CLIENT_SECRET=your_vimeo_client_secret

# Transactional email (Resend). Without RESEND_API_KEY the signup
# verification endpoint returns 502 rather than claiming it sent a code.
# In development (DEBUG=true) the code is logged and returned instead, so a
# key is only needed locally when you want to test ACTUAL delivery.
RESEND_API_KEY=re_your_resend_api_key
# Local development only. The "000000" code and the devCode field in responses are
# a full authentication bypass, so they need ALL of: DEBUG=true,
# ALLOW_INSECURE_DEV_CODES=true and EMAIL_VERIFICATION_DEV_CODES (default true).
# DEBUG alone no longer enables them. Never set this on a reachable server.
# ALLOW_INSECURE_DEV_CODES=false
# Auth abuse limits are on by default (per worker process: with N workers the
# ceiling is up to N times the configured number; Redis would make it global).
# Sign-in limits are keyed on (account, client address) so an attacker cannot lock
# the owner out from another address. Set TRUST_PROXY_HEADERS=true only when a
# reverse proxy APPENDS the client address to X-Forwarded-For, and set
# TRUSTED_PROXY_HOPS to how many proxies you run (default 1): the address is read
# that many places from the RIGHT of the header, never from the client-supplied
# left end. Otherwise per-address limits are skipped (per-account limits stay on,
# with a higher threshold and exponential back-off).
# AUTH_RATE_LIMIT_ENABLED=true
# Edge limit (primary protection): see docs/ops/nginx-auth-rate-limit.md
# REQUIREMENT for address limits (claim-code address bucket, guest/wallet creation):
# behind exactly one trusted proxy set BOTH TRUST_PROXY_HEADERS=true and
# TRUSTED_PROXY_HOPS=1, and never expose the app port (8000) directly, or clients can
# spoof X-Forwarded-For. Left unset, address limits are silently off (a WARNING is
# logged at request time once no usable client address is seen; /health deliberately
# reports nothing about this). See docs/ops/nginx-auth-rate-limit.md.
# TRUST_PROXY_HEADERS=false
# TRUSTED_PROXY_HOPS=1
# The sending domain must be verified in Resend or every send is rejected.
# That domain is the SUBdomain hello.levelup.com.ng, NOT the root: the root MX
# is reserved for a future mailbox provider and its SPF belongs to WhoGoHost.
# See "Resend sender" in DEPLOY-SETUP.md. Leaving this unset is fine — the
# config.py default is already the verified sender.
EMAIL_FROM=LevelUp (local) <noreply@hello.levelup.com.ng>
