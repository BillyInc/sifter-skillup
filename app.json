{
  "expo": {
    "name": "Sifter LevelUp",
    "slug": "sifter-levelup",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#111827"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.sifterlevelup",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan QR codes for wallet connection",
        "NSFaceIDUsageDescription": "Used to authenticate your account",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#111827"
      },
      "package": "app.sifterlevelup",
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#111827"
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "sifter",
    "extra": {
      "eas": {
        "projectId": "dcfa9963-3ccf-4ae8-8d2b-c0784a57ce21"
      },
      "telegramBotUsername": "SifterSkillUpBot",
      "baseChainId": 8453,
      "baseMiniAppId": "sifter-levelup",
      "router": {}
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "themeColor": "#111827",
      "description": "Search any Nigerian university programme and see the skills it teaches, the career fields it opens, and every university that offers it."
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "owner": "godofshinobi"
  }
}
