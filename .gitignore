node_modules/
.expo/
dist/

# Web bundle output from a scratch `expo export`. 77 files / 24MB of hashed,
# minified chunks were committed and then went stale, so they were neither
# useful nor reviewable -- a one-line source change could not be told apart
# from a rebuild. `.expo/` above does not cover it; the directory is a
# sibling, not a child. metro.config.js and tsconfig.json still list it under
# blockList/exclude on purpose: it regenerates locally, and those rules keep
# Metro and tsc from walking it when it does.
.expo-web-test/

# Jest coverage output. `--coverage` is how CI runs the suite, so anyone who
# reproduces CI locally generates this; without the ignore it shows up in
# `git status` and gets committed by accident (PR #108 carries 113 such files,
# which is why its diff reads as 114 files for a one-file change).
coverage/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
dist-web/

# Local browser profile and Vite run log; never commit machine state.
**/.edge-profile/
web-vite.log

# Env files
.env
.env.local
backend/.env
# Timestamped .env copies. These are full secret files -- an unignored
# backup is one `git add -A` away from being committed.
.env.bak*
*/.env.bak*
backend/.env.bak*

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
# Temporary audit/test worktrees can be ACL-protected on Windows. Keep Git and
# ripgrep from traversing these disposable pytest directories during normal use.
.pytest-tmp-*/

# Backend logs
backend/logs/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Local Netlify folder
.netlify
build-*.apk

